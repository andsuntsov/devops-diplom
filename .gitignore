# Terraform working directories
**/.terraform/

# Terraform state
*.tfstate
*.tfstate.*
*.tfplan

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# CLI configuration
.terraformrc
terraform.rc

# Environment files / credentials
.env
.env.*
*.pem
*.key

# Python
.venv/
__pycache__/

# Terraform service account credentials
**/terraform-sa-key.json

# Terraform S3 backend credentials
**/terraform-backend-credentials

# Kubespray generated credentials and kubeconfig
ansible/inventory/*/artifacts/
ansible/inventory/*/credentials/
monitoring/kube-prometheus/secrets/
terraform/infrastructure/tfplan
